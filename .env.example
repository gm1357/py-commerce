# API (read by apps/api via pydantic-settings)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/pycommerce
CORS_ORIGINS=["http://localhost:3000"]
SESSION_TTL_DAYS=7
# Set to true in production (HTTPS) so the session cookie is never sent over plain HTTP.
COOKIE_SECURE=false

# Web (read by the generated api-client)
NEXT_PUBLIC_API_URL=http://localhost:8000
